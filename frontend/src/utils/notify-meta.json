  "guideGroups": [
    {
      "title": "企业微信机器人 / 企业微信应用",
      "chipClass": "settings-chip-success",
      "description": "支持 13 种通知渠道，类型与字段定义统一来自共享元数据；后续新增或调整渠道时，前后端会同步读取这里。",
      "types": ["wecom_bot", "wecom_app"]
    },
    {
      "title": "Telegram / iGot",
      "chipClass": "settings-chip-primary",
      "description": "Telegram 支持 Bot Token、用户 ID 与代理配置；iGot 只需填写 PUSH_KEY 即可推送。",
      "types": ["telegram", "igot"]
    },
    {
      "title": "邮件 (SMTP) / Server酱",
      "chipClass": "settings-chip-warning",
      "description": "SMTP 按旧项目字段直接配置服务器、邮箱与授权码；Server酱支持旧版和 Turbo 版 PUSH_KEY。",
      "types": ["smtp", "serverj"]
    },
    {
      "title": "Bark / Media Saber",
      "chipClass": "settings-chip-teal",
      "description": "Bark 支持设备码、分组、声音与跳转 URL；Media Saber 需要服务器地址与 API Key。",
      "types": ["bark", "mediasaber"]
    },
    {
      "title": "钉钉 / 飞书 / Synology Chat / Slack",
      "chipClass": "settings-chip-info",
      "description": "办公协作类渠道已兼容旧项目前端的钉钉、飞书、Chat 字段格式，并继续保留 Slack Webhook。",
      "types": ["dingding", "feishu", "chat", "slack"]
    },
    {
      "title": "自定义 Webhook",
      "chipClass": "settings-chip-neutral",
      "description": "支持 POST / GET、自定义 Header 与 Body，可用 $title / $content 作为占位符。",
      "types": ["webhook"]
    }
  ]
